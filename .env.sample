CONTENTSTACK_API_KEY=
CONTENTSTACK_DELIVERY_TOKEN=
CONTENTSTACK_PREVIEW_TOKEN=
CONTENTSTACK_ENVIRONMENT=
CONTENTSTACK_HOST=
CONTENTSTACK_REGION=
CONTENTSTACK_PREVIEW_HOST=
CONTENTSTACK_BRANCH=
CONTENTSTACK_PERSONALIZATION=
CONTENTSTACK_PERSONALIZE_EDGE_API_URL=
LYTICS_TAG=
LIVE_PREVIEW_ENABLED=
HOSTING=

# Supabase - Project Settings > API Keys in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) - server-only, used by /api/auth/register to
# bypass RLS when creating a member's profile row. Never expose to the client.
SUPABASE_SECRET_KEY=

# PayPal - developer.paypal.com > Apps & Credentials. Client ID is public
# (loaded in the browser via the PayPal JS SDK); the secret is server-only
# and used to create/capture/verify orders. PAYPAL_ENVIRONMENT defaults to
# sandbox if unset - set to "live" only once you've confirmed the
# credentials are a live app, not a sandbox one.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
